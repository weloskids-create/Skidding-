-- =============================================================================
--  UltimateX — Silent Aim Module
--  Designed to run outside the main obfuscated script via loadstring.
--  Config is shared through getgenv().UX_SilentAim and getgenv().UX_SilentCleanup.
-- =============================================================================

local Players            = game:GetService("Players")
local RunService         = game:GetService("RunService")
local UserInputService   = game:GetService("UserInputService")
local Camera             = workspace.CurrentCamera
local player             = Players.LocalPlayer

-- ── Safety guard: don't install twice ──
if getgenv().UX_SilentAim and getgenv().UX_SilentAim._installed then
    if getgenv().UX_SilentCleanup then getgenv().UX_SilentCleanup() end
end

-- =============================================================================
--  Shared config table — UltimateX.lua writes to this to toggle features
-- =============================================================================
local cfg = {
    _installed          = true,
    Enabled             = false,

    -- targeting
    TargetPart          = "Head",       -- "Head" | "HumanoidRootPart" | "Torso" | "UpperTorso" | "LowerTorso" | "Random"
    HeadshotChance      = 100,          -- 0-100: % chance to aim Head vs RootPart
    HitChance           = 100,          -- 0-100: % chance any redirect fires at all
    IncludeNPCs         = false,        -- also target Humanoid NPCs (non-player)
    TeamCheck           = false,        -- skip teammates

    -- filter
    MethodRay           = "All",        -- "All" | "Exclude" | "Include" — only redirect Raycast calls whose RaycastParams match
    Wallbang            = false,        -- swap filter to Include only target part (shoot through walls)
    VisibleCheck        = false,        -- skip targets behind walls (uses oldray so no recursive loop)
    AliveCheck          = true,
    ForcefieldCheck     = true,
    GodModeCheck        = false,

    -- FOV
    FOVEnabled          = false,
    FOVRadius           = 150,
    FOVVisible          = true,
    FOVColor            = Color3.fromRGB(255, 180, 50),
    FOVThickness        = 1,

    -- prediction (for projectile-based games)
    Prediction          = false,
    PredictionFactor    = 0.165,        -- multiplier on velocity offset (tuned per game)
}
getgenv().UX_SilentAim = cfg

-- =============================================================================
--  Internals
-- =============================================================================
local rand             = Random.new()
local randomParts      = {"Head", "UpperTorso", "LowerTorso", "HumanoidRootPart"}
local currentRandPart  = "Head"
local lastRandTick     = 0

local oldRaycast, oldFindPartOnRay, oldFindPartOnRayIgnore,
      oldFindPartOnRayWhitelist, oldViewportPointToRay,
      oldScreenPointToRay, oldRayNew

local fovCircle
if Drawing then
    fovCircle              = Drawing.new("Circle")
    fovCircle.Visible      = false
    fovCircle.Color        = cfg.FOVColor
    fovCircle.Thickness    = cfg.FOVThickness
    fovCircle.Filled       = false
    fovCircle.Transparency = 0.6
end

-- Whitelist params for wallbang (reused, avoids GC churn)
local wallbangParams = RaycastParams.new()
wallbangParams.FilterType = Enum.RaycastFilterType.Include

-- ── Mouse / touch position ──
local function getMousePos()
    if UserInputService.TouchEnabled then
        return Camera.ViewportSize / 2
    end
    return UserInputService:GetMouseLocation()
end

-- ── Target part resolution ──
local function resolveTargetPart(char)
    local name = cfg.TargetPart
    -- Headshot chance: if TargetPart is Head, sometimes fall back to RootPart
    if name == "Head" and cfg.HeadshotChance < 100 then
        if rand:NextNumber(0, 100) > cfg.HeadshotChance then
            name = "HumanoidRootPart"
        end
    end
    if name == "Random" then
        if tick() - lastRandTick >= 0.25 then
            currentRandPart = randomParts[rand:NextInteger(1, #randomParts)]
            lastRandTick    = tick()
        end
        name = currentRandPart
    end
    -- R6 compat: Torso vs UpperTorso
    local part = char:FindFirstChild(name)
    if not part and name == "UpperTorso" then
        part = char:FindFirstChild("Torso")
    end
    return part or char:FindFirstChild("HumanoidRootPart")
end

-- ── Validity checks ──
local function passesChecks(plr, char)
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    if not hum then return false end

    if cfg.AliveCheck and hum.Health <= 0 then return false end
    if cfg.ForcefieldCheck and char:FindFirstChildOfClass("ForceField") then return false end
    if cfg.GodModeCheck then
        local hp = tostring(hum.Health)
        if hp == "inf" or hp:lower() == "nan" or hum.Health >= 1e18 then return false end
    end

    if cfg.TeamCheck and plr and player.Team and plr.Team and plr.Team == player.Team then
        -- Same team — skip unless only one team exists
        if #player.Team:GetPlayers() ~= #Players:GetPlayers() then return false end
    end

    if cfg.VisibleCheck then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            -- Use the old un-hooked raycast to avoid recursive triggering
            local origin = Camera.CFrame.Position
            local dir    = (hrp.Position - origin)
            if oldRaycast then
                local params = RaycastParams.new()
                params.FilterType = Enum.RaycastFilterType.Exclude
                params.FilterDescendantsInstances = {player.Character, Camera}
                local result = oldRaycast(workspace, origin, dir, params)
                if result and not result.Instance:IsDescendantOf(char) then return false end
            end
        end
    end

    return true
end

-- ── NPC check ──
local function isValidNPC(model)
    return model:FindFirstChildWhichIsA("Humanoid") and
           not Players:GetPlayerFromCharacter(model)
end

-- ── Find closest target ──
local function getClosestTarget()
    local mousePos     = getMousePos()
    local useFov       = cfg.FOVEnabled
    local fovR         = cfg.FOVRadius
    local closest      = nil
    local closestDist  = useFov and fovR or math.huge

    -- Player targets
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == player then continue end
        local char = plr.Character
        if not char then continue end
        if not passesChecks(plr, char) then continue end

        local part = resolveTargetPart(char)
        if part then
            local sPos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                local dist = (Vector2.new(sPos.X, sPos.Y) - mousePos).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closest     = { char = char, part = part }
                end
            end
        end
    end

    -- NPC targets
    if cfg.IncludeNPCs then
        for _, model in ipairs(workspace:GetDescendants()) do
            if model:IsA("Model") and isValidNPC(model) then
                if not passesChecks(nil, model) then continue end
                local part = resolveTargetPart(model)
                if part then
                    local sPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local dist = (Vector2.new(sPos.X, sPos.Y) - mousePos).Magnitude
                        if dist < closestDist then
                            closestDist = dist
                            closest     = { char = model, part = part }
                        end
                    end
                end
            end
        end
    end

    return closest
end

-- ── Direction redirect with optional velocity prediction ──
local function silentRedirect(origin, targetPart)
    local targetPos = targetPart.Position

    if cfg.Prediction then
        -- Simple linear velocity prediction scaled by PredictionFactor
        -- Works for most gun games; tune PredictionFactor per game
        local vel = targetPart:IsA("BasePart") and targetPart.Velocity or Vector3.zero
        local dist = (targetPos - origin).Magnitude
        local travelTime = dist / math.max(1, 1000) -- assume ~1000 studs/s projectile
        targetPos = targetPos + vel * travelTime * cfg.PredictionFactor
    end

    return CFrame.lookAt(origin, targetPos).LookVector
end

-- ── Roll hit chance before acquiring target ──
local function trySilentTarget()
    if not cfg.Enabled then return nil end
    if cfg.HitChance < 100 then
        if rand:NextNumber(0, 100) > cfg.HitChance then return nil end
    end
    return getClosestTarget()
end

-- ── Raycast method filter ──
local function methodAllowed(params)
    if cfg.MethodRay == "All" or not params then return true end
    if cfg.MethodRay == "Exclude" and params.FilterType == Enum.RaycastFilterType.Exclude then return true end
    if cfg.MethodRay == "Include" and params.FilterType == Enum.RaycastFilterType.Include then return true end
    return false
end

-- ── Apply wallbang params ──
local function applyWallbang(targetPart, existingParams)
    if not cfg.Wallbang then return existingParams end
    wallbangParams.FilterDescendantsInstances = {targetPart}
    return wallbangParams
end

-- =============================================================================
--  Hook installation
-- =============================================================================
oldRaycast = hookfunction(workspace.Raycast, newcclosure(function(self, origin, direction, params)
    if cfg.Enabled and not checkcaller() and methodAllowed(params) then
        local target = trySilentTarget()
        if target and target.part then
            direction = silentRedirect(origin, target.part) * direction.Magnitude
            params    = applyWallbang(target.part, params)
        end
    end
    return oldRaycast(self, origin, direction, params)
end))

oldFindPartOnRay = hookfunction(workspace.FindPartOnRay, newcclosure(function(self, ray, ...)
    if cfg.Enabled and not checkcaller() then
        local target = trySilentTarget()
        if target and target.part then
            local o = ray.Origin
            ray = Ray.new(o, silentRedirect(o, target.part) * ray.Direction.Magnitude)
        end
    end
    return oldFindPartOnRay(self, ray, ...)
end))

oldFindPartOnRayIgnore = hookfunction(workspace.FindPartOnRayWithIgnoreList, newcclosure(function(self, ray, ignoreList, ...)
    if cfg.Enabled and not checkcaller() then
        local target = trySilentTarget()
        if target and target.part then
            local o = ray.Origin
            ray = Ray.new(o, silentRedirect(o, target.part) * ray.Direction.Magnitude)
            if cfg.Wallbang then ignoreList = {} end -- don't ignore anything
        end
    end
    return oldFindPartOnRayIgnore(self, ray, ignoreList, ...)
end))

oldFindPartOnRayWhitelist = hookfunction(workspace.FindPartOnRayWithWhitelist, newcclosure(function(self, ray, whitelist, ...)
    if cfg.Enabled and not checkcaller() then
        local target = trySilentTarget()
        if target and target.part then
            local o = ray.Origin
            ray      = Ray.new(o, silentRedirect(o, target.part) * ray.Direction.Magnitude)
            whitelist = cfg.Wallbang and {target.part} or whitelist
        end
    end
    return oldFindPartOnRayWhitelist(self, ray, whitelist, ...)
end))

oldViewportPointToRay = hookfunction(Camera.ViewportPointToRay, newcclosure(function(self, x, y, depth)
    if cfg.Enabled and not checkcaller() then
        local target = trySilentTarget()
        if target and target.part then
            local origin = Camera.CFrame.Position
            return Ray.new(origin, silentRedirect(origin, target.part))
        end
    end
    return oldViewportPointToRay(self, x, y, depth)
end))

oldScreenPointToRay = hookfunction(Camera.ScreenPointToRay, newcclosure(function(self, x, y, depth)
    if cfg.Enabled and not checkcaller() then
        local target = trySilentTarget()
        if target and target.part then
            local origin = Camera.CFrame.Position
            return Ray.new(origin, silentRedirect(origin, target.part))
        end
    end
    return oldScreenPointToRay(self, x, y, depth)
end))

oldRayNew = hookfunction(Ray.new, newcclosure(function(origin, direction)
    if cfg.Enabled and not checkcaller() then
        local target = trySilentTarget()
        if target and target.part then
            direction = silentRedirect(origin, target.part) * direction.Magnitude
        end
    end
    return oldRayNew(origin, direction)
end))

-- =============================================================================
--  FOV circle RenderStepped loop
-- =============================================================================
local fovConn = RunService.RenderStepped:Connect(function()
    if not fovCircle then return end
    if cfg.Enabled and cfg.FOVEnabled and cfg.FOVVisible then
        local mousePos     = getMousePos()
        fovCircle.Position = Vector2.new(mousePos.X, mousePos.Y)
        fovCircle.Radius   = cfg.FOVRadius
        fovCircle.Color    = cfg.FOVColor
        fovCircle.Visible  = true
    else
        fovCircle.Visible = false
    end
end)

-- =============================================================================
--  Cleanup function — exposed to main script via getgenv()
-- =============================================================================
getgenv().UX_SilentCleanup = function()
    pcall(function() fovConn:Disconnect() end)
    pcall(function() if fovCircle then fovCircle:Remove() end end)
    pcall(function() if oldRaycast              then hookfunction(workspace.Raycast,                       oldRaycast)              end end)
    pcall(function() if oldFindPartOnRay        then hookfunction(workspace.FindPartOnRay,                 oldFindPartOnRay)        end end)
    pcall(function() if oldFindPartOnRayIgnore  then hookfunction(workspace.FindPartOnRayWithIgnoreList,   oldFindPartOnRayIgnore)  end end)
    pcall(function() if oldFindPartOnRayWhitelist then hookfunction(workspace.FindPartOnRayWithWhitelist,  oldFindPartOnRayWhitelist) end end)
    pcall(function() if oldViewportPointToRay   then hookfunction(Camera.ViewportPointToRay,               oldViewportPointToRay)   end end)
    pcall(function() if oldScreenPointToRay     then hookfunction(Camera.ScreenPointToRay,                 oldScreenPointToRay)     end end)
    pcall(function() if oldRayNew               then hookfunction(Ray.new,                                 oldRayNew)               end end)
    getgenv().UX_SilentAim     = nil
    getgenv().UX_SilentCleanup = nil
end
