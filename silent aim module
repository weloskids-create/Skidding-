local origSPTR = Camera.ScreenPointToRay
hooks[#hooks + 1] = {
    original = origSPTR,
    restore  = hookfunction(origSPTR, newcclosure(function(self, x, y, depth)
        local ray = origSPTR(self, x, y, depth)
        if not Config.Enabled or checkcaller() then return ray end
        local origin = ray.Origin
        local targetPart, predPos = getTarget(origin)
        if not targetPart then return ray end
        return Ray.new(origin, CFrame.lookAt(origin, predPos).LookVector * ray.Direction.Magnitude)
    end))
}

