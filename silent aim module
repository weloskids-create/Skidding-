-- 1.0.0.3

local cloneref = (type(cloneref) == "function") and cloneref or function(x) return x end
local function svc(n)
    local s = nil
    pcall(function() s = cloneref(game:GetService(n)) end)
    return s or game:GetService(n)
end

local unpack = table.unpack or unpack

local Players          = svc("Players")
local RunService       = svc("RunService")
local UserInputService = svc("UserInputService")

local RealWorkspace = game:GetService("Workspace")
local LocalPlayer   = Players.LocalPlayer

local function getCamera()
    return RealWorkspace.CurrentCamera
end

local function getMouse()
    if not LocalPlayer then return nil end
    local m = nil
    pcall(function() m = LocalPlayer:GetMouse() end)
    return m
end

local SilentAim = {
    Enabled = false,
    HitChance = 100,
    TargetPart = "Head",

    FOVRadius = 150,
    FOVVisible = false,
    FOVColor = Color3.fromRGB(255, 255, 255),
    FOVTransparency = 0.6,

    TeamCheck = false,
    AliveCheck = true,
    ForcefieldCheck = false,
    VisibleCheck = false,
    GodModeCheck = false,

    Prediction = false,
    PredictionAmount = 0.135,

    SelectedTarget = nil,
    SelectedPart = nil,
}

getgenv().UltimateX_SilentAim = SilentAim

local hasDrawing = false
local fovCircle  = nil

pcall(function()
    if type(Drawing) == "table" and type(Drawing.new) == "function" then
        local test = Drawing.new("Circle")
        if test then
            pcall(function()
                if test.Remove then test:Remove() elseif test.Destroy then test:Destroy() end
            end)
            hasDrawing = true
        end
    end
end)

if hasDrawing then
    pcall(function()
        fovCircle = Drawing.new("Circle")
        fovCircle.Thickness    = 1
        fovCircle.NumSides     = 64
        fovCircle.Radius       = SilentAim.FOVRadius
        fovCircle.Filled       = false
        fovCircle.Visible      = false
        fovCircle.Transparency = SilentAim.FOVTransparency
        fovCircle.Color        = SilentAim.FOVColor
    end)
end

local randomParts       = {"Head", "HumanoidRootPart", "Torso", "UpperTorso", "LowerTorso"}
local currentRandomPart = "Head"
local lastRandomUpdate  = tick()

local function resolveTargetPart(char, preferred)
    if not char then return nil end
    if preferred == "Random" then
        if tick() - lastRandomUpdate >= 0.25 then
            currentRandomPart = randomParts[math.random(1, #randomParts)]
            lastRandomUpdate  = tick()
        end
        return char:FindFirstChild(currentRandomPart)
            or char:FindFirstChild("HumanoidRootPart")
            or char:FindFirstChild("Head")
    end
    if preferred == "Torso" then
        return char:FindFirstChild("Torso")
            or char:FindFirstChild("UpperTorso")
            or char:FindFirstChild("LowerTorso")
            or char:FindFirstChild("HumanoidRootPart")
    elseif preferred == "Upper Torso" then
        return char:FindFirstChild("UpperTorso")
            or char:FindFirstChild("Torso")
            or char:FindFirstChild("HumanoidRootPart")
    elseif preferred == "Lower Torso" then
        return char:FindFirstChild("LowerTorso")
            or char:FindFirstChild("Torso")
            or char:FindFirstChild("HumanoidRootPart")
    end
    return char:FindFirstChild(preferred)
        or char:FindFirstChild("HumanoidRootPart")
        or char:FindFirstChild("Head")
end

local _hookGuard = false

local oldNamecall = nil
local oldIndex    = nil

local function isWeaponRay(origin)
    if typeof(origin) ~= "Vector3" then return false end

    local cam = getCamera()
    if cam then
        local camPos = cam.CFrame.Position
        if (origin - camPos).Magnitude <= 20 then
            return true
        end
    end

    if LocalPlayer and LocalPlayer.Character then
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp and (origin - hrp.Position).Magnitude <= 12 then
            return true
        end
    end

    return false
end

local function isAimedNearMouse(origin, direction)
    local cam = getCamera()
    if not cam then return true end

    local mousePos  = UserInputService:GetMouseLocation()
    local mouseRay  = cam:ViewportPointToRay(mousePos.X, mousePos.Y)
    local rayDir    = direction.Unit
    local mouseDir  = mouseRay.Direction.Unit

    local dot = rayDir:Dot(mouseDir)
    return dot >= math.cos(math.rad(25))
end

local function passesValidation(targetPlr, char)
    if not targetPlr or targetPlr == LocalPlayer or not char then return false end

    if SilentAim.TeamCheck then
        if LocalPlayer.Team and targetPlr.Team and targetPlr.Team == LocalPlayer.Team then
            return false
        end
    end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end

    if SilentAim.AliveCheck and hum.Health <= 0 then
        return false
    end

    if SilentAim.ForcefieldCheck and char:FindFirstChildOfClass("ForceField") then
        return false
    end

    if SilentAim.GodModeCheck then
        local hp = tostring(hum.Health)
        if hp == "inf" or hp:lower() == "nan" or hum.Health >= 1e18 then
            return false
        end
    end

    if SilentAim.VisibleCheck then
        local part = resolveTargetPart(char, SilentAim.TargetPart)
        if part then
            local cam = getCamera()
            if cam then
                local rayParams = RaycastParams.new()
                rayParams.FilterType = Enum.RaycastFilterType.Exclude
                local filterList = {cam}
                if LocalPlayer.Character then
                    table.insert(filterList, LocalPlayer.Character)
                end
                rayParams.FilterDescendantsInstances = filterList
                rayParams.IgnoreWater = true

                local origin = cam.CFrame.Position
                local dir    = part.Position - origin

                local result = nil
                local wasGuard = _hookGuard
                _hookGuard = true
                pcall(function()
                    result = oldNamecall(RealWorkspace, origin, dir, rayParams)
                end)
                _hookGuard = wasGuard

                if result and result.Instance and not result.Instance:IsDescendantOf(char) then
                    return false
                end
            end
        end
    end

    return true
end

local function rollHitChance()
    local chance = math.clamp(SilentAim.HitChance or 100, 0, 100)
    if chance >= 100 then return true end
    if chance <= 0  then return false end
    return math.random(1, 100) <= chance
end

local function getClosestTarget()
    if not SilentAim.Enabled then return nil, nil end
    local cam = getCamera()
    if not cam then return nil, nil end

    local mousePos     = UserInputService:GetMouseLocation()
    local shortestDist = SilentAim.FOVRadius or 150
    local closestPlr   = nil
    local closestPart  = nil

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            if passesValidation(plr, char) then
                local part = resolveTargetPart(char, SilentAim.TargetPart)
                if part then
                    local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if dist <= shortestDist then
                            shortestDist = dist
                            closestPlr   = plr
                            closestPart  = part
                        end
                    end
                end
            end
        end
    end

    SilentAim.SelectedTarget = closestPlr
    SilentAim.SelectedPart   = closestPart
    return closestPlr, closestPart
end

local _frameCounter = 0
local _cachedFrame  = 0
local _cachedTarget = nil
local _cachedPart   = nil
local _cachedRoll   = false

local function resolveFrameTarget()
    if _cachedFrame == _frameCounter then
        return _cachedRoll, _cachedTarget, _cachedPart
    end
    _cachedFrame = _frameCounter

    local plr, part = getClosestTarget()
    _cachedTarget = plr
    _cachedPart   = part

    if not part then
        _cachedRoll = false
        return false, nil, nil
    end

    _cachedRoll = rollHitChance()
    return _cachedRoll, _cachedTarget, _cachedPart
end

local function getPredictedPosition(part)
    if not part then return nil end
    local pos = part.Position
    if SilentAim.Prediction then
        local vel = Vector3.zero
        pcall(function()
            vel = part.AssemblyLinearVelocity or part.Velocity or Vector3.zero
        end)
        pos = pos + vel * (SilentAim.PredictionAmount or 0.135)
    end
    return pos
end

RunService.RenderStepped:Connect(function()
    _frameCounter = _frameCounter + 1

    if fovCircle then
        if SilentAim.Enabled and SilentAim.FOVVisible then
            local mousePos = UserInputService:GetMouseLocation()
            fovCircle.Position     = mousePos
            fovCircle.Radius       = SilentAim.FOVRadius or 150
            fovCircle.Color        = SilentAim.FOVColor or Color3.fromRGB(255, 255, 255)
            fovCircle.Transparency = SilentAim.FOVTransparency or 0.6
            fovCircle.Visible      = true
        else
            fovCircle.Visible = false
        end
    end
end)

local function hookMetamethods()
    if not hookmetamethod or not getnamecallmethod or not checkcaller or not newcclosure then
        return
    end

    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)

        if _hookGuard then
            return oldNamecall(self, ...)
        end

        if not checkcaller() and SilentAim.Enabled
            and (rawequal(self, RealWorkspace) or self == RealWorkspace) then

            local method = getnamecallmethod()

            if method == "Raycast"
                or method == "FindPartOnRay"
                or method == "FindPartOnRayWithIgnoreList"
                or method == "FindPartOnRayWithWhitelist" then

                local args = {...}

                local origin, direction
                if method == "Raycast" then
                    origin    = args[1]
                    direction = args[2]
                else
                    local ray = args[1]
                    if typeof(ray) == "Ray" then
                        origin    = ray.Origin
                        direction = ray.Direction
                    end
                end

                if isWeaponRay(origin) and isAimedNearMouse(origin, direction or Vector3.zero) then
                    _hookGuard = true
                    local shouldHit, _, targetPart = resolveFrameTarget()
                    _hookGuard = false

                    if shouldHit and targetPart then
                        local targetPos = getPredictedPosition(targetPart)
                        if targetPos then
                            if method == "Raycast" then
                                local mag = direction and direction.Magnitude or 0
                                if mag > 0 then
                                    args[2] = (targetPos - origin).Unit * mag
                                    return oldNamecall(self, unpack(args))
                                end
                            else
                                local ray = args[1]
                                local mag = ray.Direction.Magnitude
                                if mag > 0 then
                                    args[1] = Ray.new(ray.Origin, (targetPos - ray.Origin).Unit * mag)
                                    return oldNamecall(self, unpack(args))
                                end
                            end
                        end
                    end
                end
            end
        end

        return oldNamecall(self, ...)
    end))

    oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, index)
        if _hookGuard then
            return oldIndex(self, index)
        end

        if not checkcaller() and SilentAim.Enabled then
            local mouse = getMouse()
            if mouse and rawequal(self, mouse) then
                if index == "Hit" or index == "Target" then
                    local firing = false
                    pcall(function()
                        firing = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
                    end)

                    if firing then
                        _hookGuard = true
                        local shouldHit, _, targetPart = resolveFrameTarget()
                        _hookGuard = false

                        if shouldHit and targetPart then
                            local targetPos = getPredictedPosition(targetPart)
                            if targetPos then
                                if index == "Hit" then
                                    return CFrame.new(targetPos)
                                else
                                    return targetPart
                                end
                            end
                        end
                    end
                end
            end
        end

        return oldIndex(self, index)
    end))
end

pcall(hookMetamethods)

SilentAim.Cleanup = function()
    SilentAim.Enabled = false
    if fovCircle then
        pcall(function()
            if fovCircle.Remove then fovCircle:Remove() elseif fovCircle.Destroy then fovCircle:Destroy() end
        end)
        fovCircle = nil
    end
end

return SilentAim
