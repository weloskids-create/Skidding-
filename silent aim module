local cloneref = (type(cloneref) == "function") and cloneref or function(x) return x end
local newccl = newcclosure or function(f) return f end
local checkc = checkcaller or function() return false end
local getncm = getnamecallmethod or get_namecall_method or function() return "" end

local Players = cloneref(game:GetService("Players"))
local RunService = cloneref(game:GetService("RunService"))
local UserInputService = cloneref(game:GetService("UserInputService"))
local Camera = workspace.CurrentCamera
local lplr = Players.LocalPlayer
local Mouse = lplr:GetMouse()

local WorldToScreen = Camera.WorldToScreenPoint

local Config = {
    Enabled = false,
    FOV = 130,
    TargetPart = "HumanoidRootPart",
    HeadshotChance = 0,
    HitChance = 100,
    TeamCheck = false,
    WallCheck = false,
    ShowFOV = false,
    FOVColor = Color3.fromRGB(255, 255, 255),
    FOVThickness = 1,
    PredictEnabled = false,
    PredictAmount = 0.165,
}

if type(getgenv) == "function" and type(getgenv().UX_SilentAim) == "table" and type(getgenv().UX_SilentAim.Config) == "table" then
    for k, v in pairs(getgenv().UX_SilentAim.Config) do
        Config[k] = v
    end
end

local ValidTargetParts = {"Head", "HumanoidRootPart"}

local ExpectedArguments = {
    FindPartOnRayWithIgnoreList = {
        ArgCountRequired = 3,
        Args = {"Instance", "Ray", "table", "boolean", "boolean"}
    },
    FindPartOnRayWithWhitelist = {
        ArgCountRequired = 3,
        Args = {"Instance", "Ray", "table", "boolean"}
    },
    FindPartOnRay = {
        ArgCountRequired = 2,
        Args = {"Instance", "Ray", "Instance", "boolean", "boolean"}
    },
    Raycast = {
        ArgCountRequired = 3,
        Args = {"Instance", "Vector3", "Vector3", "RaycastParams"}
    }
}

local function ValidateArguments(Args, RayMethod)
    if #Args < RayMethod.ArgCountRequired then return false end
    local Matches = 0
    for Pos, Argument in next, Args do
        if typeof(Argument) == RayMethod.Args[Pos] then
            Matches = Matches + 1
        end
    end
    return Matches >= RayMethod.ArgCountRequired
end

local function CalculateChance(Percentage)
    Percentage = math.floor(Percentage)
    local chance = math.floor(Random.new():NextNumber(0, 1) * 100) / 100
    return chance <= Percentage / 100
end

local function getMousePosition()
    if UserInputService.TouchEnabled then
        return Camera.ViewportSize / 2
    end
    return UserInputService:GetMouseLocation()
end

local function getPositionOnScreen(Vector)
    local Vec3, OnScreen = WorldToScreen(Camera, Vector)
    return Vector2.new(Vec3.X, Vec3.Y), OnScreen
end

local function getDirection(Origin, Position)
    return (Position - Origin).Unit * 1000
end

local function IsPlayerVisible(Character)
    local lchar = lplr.Character
    if not (Character and lchar) then return false end
    local root = Character:FindFirstChild(Config.TargetPart) or Character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local obscuring = #Camera:GetPartsObscuringTarget({root.Position}, {lchar, Character})
    return obscuring == 0
end

local function getClosestPlayer()
    local Closest = nil
    local DistanceToMouse = nil
    local mousePos = getMousePosition()

    for _, Player in next, Players:GetPlayers() do
        if Player == lplr then continue end
        if Config.TeamCheck and Player.Team == lplr.Team then continue end

        local Character = Player.Character
        if not Character then continue end

        local Humanoid = Character:FindFirstChildOfClass("Humanoid")
        if not Humanoid or Humanoid.Health <= 0 then continue end
        if Character:FindFirstChildOfClass("ForceField") then continue end

        if Config.WallCheck and not IsPlayerVisible(Character) then continue end

        local HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")
        if not HumanoidRootPart then continue end

        local ScreenPosition, OnScreen = getPositionOnScreen(HumanoidRootPart.Position)
        if not OnScreen then continue end

        local Distance = (mousePos - ScreenPosition).Magnitude
        if Distance <= (DistanceToMouse or Config.FOV) then
            local partName = Config.TargetPart
            if Config.HeadshotChance > 0 and math.random(0, 100) < Config.HeadshotChance then
                partName = "Head"
            end
            local targetPart = Character:FindFirstChild(partName) or Character:FindFirstChild("HumanoidRootPart")
            if not targetPart then continue end

            Closest = targetPart
            DistanceToMouse = Distance
        end
    end

    return Closest
end

local hasDrawing = false
local fovCircle = nil
pcall(function()
    if type(Drawing) == "table" and type(Drawing.new) == "function" then
        local t = Drawing.new("Circle")
        if t then
            pcall(function()
                if t.Remove then t:Remove() elseif t.Destroy then t:Destroy() end
            end)
            hasDrawing = true
        end
    end
end)

if hasDrawing then
    pcall(function()
        fovCircle = Drawing.new("Circle")
        fovCircle.Thickness = 1
        fovCircle.NumSides = 64
        fovCircle.Radius = Config.FOV
        fovCircle.Filled = false
        fovCircle.Visible = false
        fovCircle.ZIndex = 999
        fovCircle.Transparency = 0.7
        fovCircle.Color = Config.FOVColor
    end)
end

local fovConn = RunService.RenderStepped:Connect(function()
    if not fovCircle then return end
    if not Config.Enabled or not Config.ShowFOV then
        fovCircle.Visible = false
        return
    end
    fovCircle.Visible = true
    fovCircle.Position = getMousePosition()
    fovCircle.Radius = Config.FOV
    fovCircle.Color = Config.FOVColor
    fovCircle.Thickness = Config.FOVThickness
end)

local oldNamecall = nil
local oldIndex = nil

oldNamecall = hookmetamethod(game, "__namecall", newccl(function(...)
    local Method = getncm()
    local Arguments = {...}
    local self = Arguments[1]

    if Config.Enabled and self == workspace and not checkc() and CalculateChance(Config.HitChance) then
        if Method == "FindPartOnRayWithIgnoreList" then
            if ValidateArguments(Arguments, ExpectedArguments.FindPartOnRayWithIgnoreList) then
                local A_Ray = Arguments[2]
                local HitPart = getClosestPlayer()
                if HitPart then
                    local Origin = A_Ray.Origin
                    local Direction = getDirection(Origin, HitPart.Position)
                    Arguments[2] = Ray.new(Origin, Direction)
                    return oldNamecall(unpack(Arguments))
                end
            end
        elseif Method == "FindPartOnRayWithWhitelist" then
            if ValidateArguments(Arguments, ExpectedArguments.FindPartOnRayWithWhitelist) then
                local A_Ray = Arguments[2]
                local HitPart = getClosestPlayer()
                if HitPart then
                    local Origin = A_Ray.Origin
                    local Direction = getDirection(Origin, HitPart.Position)
                    Arguments[2] = Ray.new(Origin, Direction)
                    return oldNamecall(unpack(Arguments))
                end
            end
        elseif Method == "FindPartOnRay" or Method == "findPartOnRay" then
            if ValidateArguments(Arguments, ExpectedArguments.FindPartOnRay) then
                local A_Ray = Arguments[2]
                local HitPart = getClosestPlayer()
                if HitPart then
                    local Origin = A_Ray.Origin
                    local Direction = getDirection(Origin, HitPart.Position)
                    Arguments[2] = Ray.new(Origin, Direction)
                    return oldNamecall(unpack(Arguments))
                end
            end
        elseif Method == "Raycast" then
            if ValidateArguments(Arguments, ExpectedArguments.Raycast) then
                local A_Origin = Arguments[2]
                local HitPart = getClosestPlayer()
                if HitPart then
                    Arguments[3] = getDirection(A_Origin, HitPart.Position)
                    return oldNamecall(unpack(Arguments))
                end
            end
        end
    end

    return oldNamecall(...)
end))

oldIndex = hookmetamethod(game, "__index", newccl(function(self, Index)
    if self == Mouse and not checkc() and Config.Enabled then
        local HitPart = getClosestPlayer()
        if HitPart then
            if Index == "Target" or Index == "target" then
                return HitPart
            elseif Index == "Hit" or Index == "hit" then
                if Config.PredictEnabled then
                    return HitPart.CFrame + (HitPart.AssemblyLinearVelocity * Config.PredictAmount)
                end
                return HitPart.CFrame
            elseif Index == "UnitRay" then
                return Ray.new(Mouse.Origin, (Mouse.Hit.Position - Mouse.Origin).Unit)
            end
        end
    end
    return oldIndex(self, Index)
end))

local function Cleanup()
    pcall(function() fovConn:Disconnect() end)
    if fovCircle then
        pcall(function()
            if fovCircle.Remove then fovCircle:Remove()
            elseif fovCircle.Destroy then fovCircle:Destroy() end
        end)
        fovCircle = nil
    end
    if oldNamecall then
        pcall(function() hookmetamethod(game, "__namecall", oldNamecall) end)
        oldNamecall = nil
    end
    if oldIndex then
        pcall(function() hookmetamethod(game, "__index", oldIndex) end)
        oldIndex = nil
    end
    pcall(function()
        if type(getgenv) == "function" then
            getgenv().UX_SilentAim = nil
        end
    end)
end

local exportTable = {
    Config = Config,
    Cleanup = Cleanup,
    Active = true
}

pcall(function()
    if type(getgenv) == "function" then
        local prev = getgenv().UX_SilentAim
        if type(prev) == "table" and type(prev.Cleanup) == "function" and prev.Cleanup ~= Cleanup then
            pcall(prev.Cleanup)
        end
        getgenv().UX_SilentAim = exportTable
    end
end)

return exportTable
