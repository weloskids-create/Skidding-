-- v1
local cloneref = (type(cloneref) == "function") and cloneref or function(x) return x end
local function svc(n)
    local s = nil
    pcall(function() s = cloneref(game:GetService(n)) end)
    return s or game:GetService(n)
end

local Players = svc("Players")
local Workspace = svc("Workspace")
local RunService = svc("RunService")
local UserInputService = svc("UserInputService")
local GuiService = svc("GuiService")

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera
local Mouse = LocalPlayer and LocalPlayer:GetMouse()

local SilentAim = {
    Enabled = false,
    HitChance = 100,
    TargetPart = "Head",
    
    FOVRadius = 150,
    FOVVisible = false,
    FOVColor = Color3.fromRGB(255, 255, 255),
    FOVTransparency = 0.6,
    
    TeamCheck = false,
    AliveCheck = true,
    ForcefieldCheck = false,
    VisibleCheck = false,
    GodModeCheck = false,
    
    Prediction = false,
    PredictionAmount = 0.135,
    
    SelectedTarget = nil,
    SelectedPart = nil,
}

getgenv().UltimateX_SilentAim = SilentAim

local hasDrawing = false
local fovCircle = nil

pcall(function()
    if type(Drawing) == "table" and type(Drawing.new) == "function" then
        local test = Drawing.new("Circle")
        if test then
            pcall(function()
                if test.Remove then test:Remove() elseif test.Destroy then test:Destroy() end
            end)
            hasDrawing = true
        end
    end
end)

if hasDrawing then
    pcall(function()
        fovCircle = Drawing.new("Circle")
        fovCircle.Thickness = 1
        fovCircle.NumSides = 64
        fovCircle.Radius = SilentAim.FOVRadius
        fovCircle.Filled = false
        fovCircle.Visible = false
        fovCircle.Transparency = SilentAim.FOVTransparency
        fovCircle.Color = SilentAim.FOVColor
    end)
end

local randomParts = {"Head", "HumanoidRootPart", "Torso", "UpperTorso", "LowerTorso"}
local currentRandomPart = "Head"
local lastRandomUpdate = tick()

local function resolveTargetPart(char, preferred)
    if not char then return nil end
    if preferred == "Random" then
        if tick() - lastRandomUpdate >= 0.25 then
            currentRandomPart = randomParts[math.random(1, #randomParts)]
            lastRandomUpdate = tick()
        end
        return char:FindFirstChild(currentRandomPart) or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
    end
    
    local clean = preferred
    if clean == "Torso" then
        return char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("LowerTorso") or char:FindFirstChild("HumanoidRootPart")
    elseif clean == "Upper Torso" then
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
    elseif clean == "Lower Torso" then
        return char:FindFirstChild("LowerTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
    end
    
    return char:FindFirstChild(clean) or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
end

local function passesValidation(targetPlr, char)
    if not targetPlr or targetPlr == LocalPlayer or not char then return false end
    
    if SilentAim.TeamCheck and LocalPlayer.Team and targetPlr.Team and targetPlr.Team == LocalPlayer.Team then
        return false
    end
    
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    
    if SilentAim.AliveCheck and hum.Health <= 0 then
        return false
    end
    
    if SilentAim.ForcefieldCheck and char:FindFirstChildOfClass("ForceField") then
        return false
    end
    
    if SilentAim.GodModeCheck then
        local hp = tostring(hum.Health)
        if hp == "inf" or hp:lower() == "nan" or hum.Health >= 1e18 then
            return false
        end
    end
    
    if SilentAim.VisibleCheck then
        local targetPart = resolveTargetPart(char, SilentAim.TargetPart)
        if targetPart then
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
            rayParams.IgnoreWater = true
            
            local origin = Camera.CFrame.Position
            local dir = (targetPart.Position - origin)
            local result = Workspace:Raycast(origin, dir, rayParams)
            
            if result and result.Instance and not result.Instance:IsDescendantOf(char) then
                return false
            end
        end
    end
    
    return true
end

local function rollHitChance()
    local chance = math.clamp(SilentAim.HitChance or 100, 0, 100)
    if chance >= 100 then return true end
    if chance <= 0 then return false end
    return math.random(1, 100) <= chance
end

local function getClosestTarget()
    if not SilentAim.Enabled then return nil, nil end
    if not Camera then Camera = Workspace.CurrentCamera end
    if not Camera then return nil, nil end
    
    local mousePos = UserInputService:GetMouseLocation()
    local shortestDist = SilentAim.FOVRadius or 150
    local closestPlr = nil
    local closestPart = nil
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            if passesValidation(plr, char) then
                local part = resolveTargetPart(char, SilentAim.TargetPart)
                if part then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if dist <= shortestDist then
                            shortestDist = dist
                            closestPlr = plr
                            closestPart = part
                        end
                    end
                end
            end
        end
    end
    
    SilentAim.SelectedTarget = closestPlr
    SilentAim.SelectedPart = closestPart
    return closestPlr, closestPart
end

RunService.RenderStepped:Connect(function()
    if fovCircle then
        if SilentAim.Enabled and SilentAim.FOVVisible then
            local mousePos = UserInputService:GetMouseLocation()
            fovCircle.Position = mousePos
            fovCircle.Radius = SilentAim.FOVRadius or 150
            fovCircle.Color = SilentAim.FOVColor or Color3.fromRGB(255, 255, 255)
            fovCircle.Transparency = SilentAim.FOVTransparency or 0.6
            fovCircle.Visible = true
        else
            fovCircle.Visible = false
        end
    end
end)

local function getPredictedPosition(part)
    if not part then return nil end
    local pos = part.Position
    if SilentAim.Prediction then
        local vel = Vector3.zero
        pcall(function()
            vel = part.AssemblyLinearVelocity or part.Velocity or Vector3.zero
        end)
        pos = pos + (vel * (SilentAim.PredictionAmount or 0.135))
    end
    return pos
end

local oldNamecall = nil
local oldIndex = nil

local function hookMetamethods()
    if not hookmetamethod or not getnamecallmethod or not checkcaller or not newcclosure then
        warn("[UltimateX SilentAim] Executor does not support hookmetamethod / getnamecallmethod.")
        return
    end

    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if not checkcaller() and SilentAim.Enabled and self == Workspace then
            if method == "Raycast" then
                if rollHitChance() then
                    local _, targetPart = getClosestTarget()
                    if targetPart then
                        local origin = args[1]
                        local direction = args[2]
                        if typeof(origin) == "Vector3" and typeof(direction) == "Vector3" then
                            local targetPos = getPredictedPosition(targetPart)
                            if targetPos then
                                local newDirection = (targetPos - origin).Unit * direction.Magnitude
                                args[2] = newDirection
                                return oldNamecall(self, unpack(args))
                            end
                        end
                    end
                end
            elseif method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRay" or method == "FindPartOnRayWithWhitelist" then
                if rollHitChance() then
                    local _, targetPart = getClosestTarget()
                    if targetPart then
                        local ray = args[1]
                        if typeof(ray) == "Ray" then
                            local targetPos = getPredictedPosition(targetPart)
                            if targetPos then
                                local newDirection = (targetPos - ray.Origin).Unit * ray.Direction.Magnitude
                                args[1] = Ray.new(ray.Origin, newDirection)
                                return oldNamecall(self, unpack(args))
                            end
                        end
                    end
                end
            end
        end
        
        return oldNamecall(self, ...)
    end))

    oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, index)
        if not checkcaller() and SilentAim.Enabled then
            if Mouse and self == Mouse then
                if index == "Hit" then
                    if rollHitChance() then
                        local _, targetPart = getClosestTarget()
                        if targetPart then
                            local targetPos = getPredictedPosition(targetPart)
                            if targetPos then
                                return CFrame.new(targetPos)
                            end
                        end
                    end
                elseif index == "Target" then
                    if rollHitChance() then
                        local _, targetPart = getClosestTarget()
                        if targetPart then
                            return targetPart
                        end
                    end
                end
            end
        end
        
        return oldIndex(self, index)
    end))
end

pcall(hookMetamethods)

SilentAim.Cleanup = function()
    SilentAim.Enabled = false
    if fovCircle then
        pcall(function()
            if fovCircle.Remove then fovCircle:Remove() elseif fovCircle.Destroy then fovCircle:Destroy() end
        end)
        fovCircle = nil
    end
end

return SilentAim
