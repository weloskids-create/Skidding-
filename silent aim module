local function Cleanup()
    pcall(function() fovRenderConn:Disconnect() end)

    for _, h in ipairs(hooks) do
        pcall(function()
            if h.restore then
                hookfunction(h.restore, h.original)
            end
        end)
    end
    table.clear(hooks)

    destroyFOVCircle()

    pcall(function()
        if type(getgenv) == "function" then
            getgenv().UX_SilentAim = nil
        end
    end)
end

pcall(function()
    if type(getgenv) == "function" then
        -- Clean up any prior instance first
        local prev = getgenv().UX_SilentAim
        if type(prev) == "table" and type(prev.Cleanup) == "function" then
            pcall(prev.Cleanup)
        end
        getgenv().UX_SilentAim = {
            Config  = Config,
            Cleanup = Cleanup,
            Active  = true,
        }
    end
end)

return {
    Config  = Config,
    Cleanup = Cleanup,
    Active  = true,
}
